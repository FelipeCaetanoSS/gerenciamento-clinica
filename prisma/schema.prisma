// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Usuario{
  id    Int    @id @default(autoincrement())
  email String
  senha String
  nome String
  idade Int
  sexo String
  rg  String  @unique
  cpf Int @unique
  telefone Int
  ativo Boolean @default(true)
  role  Role
  medico Medico?
  paciente Paciente?
  notificacao Notificacao[]
}

enum Role {
  RECEPCIONISTA
  ADMIN
  MEDICO
  PACIENTE
}

model Medico{
  id    Int    @id @default(autoincrement())
  crm Int
  crmUf String?
  especialidade String?
  diasAtendimento String?
  horarioInicio String?
  horarioFim String?
  duracaoConsulta String?
  duracaoConsultaMinutos Int?
  maxConsultasDia Int?
  usuario Usuario? @relation(fields: [usuarioId], references: [id])
  usuarioId Int? @unique
  agendamento Agendamento[]
  receita Receita[]
  consulta Consulta[]
  exame Exame[]
  prontuario Prontuario[]
}

model Paciente{
  id    Int    @id @default(autoincrement())
  localnasc String?
  DataNasc DateTime?
  estadoCivil String?
  tipoSanguineo String?
  peso Float?
  altura Float?
  alergia String?
  medicamento String?
  observacao String?
  deficiencia String?
  doencas String?
  usuario Usuario? @relation(fields: [usuarioId], references: [id])
  usuarioId Int? @unique
  agendamento Agendamento[]
  convenio Convenio[]
  endereco Endereco?
  receita Receita[]
  consulta Consulta[]
  exame Exame[]
  prontuario Prontuario[]
}

model Agendamento{
  id    Int    @id @default(autoincrement())
  paciente Paciente @relation(fields: [pacienteId], references: [id])
  pacienteId Int
  medico Medico @relation(fields: [medicoId], references: [id])
  medicoId Int
  data DateTime
  status String @default("agendado")
}

model Consulta{
  id    Int    @id @default(autoincrement())
  data DateTime
  status String
  motivo String
  paciente Paciente @relation(fields: [pacienteId], references: [id])
  pacienteId Int
  medico Medico @relation(fields: [medicoId], references: [id])
  medicoId Int
}

model Receita{
  id    Int    @id @default(autoincrement())
  medico Medico @relation(fields: [medicoId], references: [id])
  medicoId Int
  paciente Paciente @relation(fields: [pacienteId], references: [id])
  pacienteId Int
  medicamento String
  dosagem String
  dias  String 
  observacao String
  prontuario Prontuario[]
}

model Notificacao{
  id    Int    @id @default(autoincrement())
  titulo String
  mensagem String
  tipo String?
  categoria String?
  lida Boolean @default(false)
  data DateTime
  usuarioId Int?
  usuario Usuario? @relation(fields: [usuarioId], references: [id])
}

model Convenio{
  id    Int    @id @default(autoincrement())
  nome String
  numCarteirinha String
  validade DateTime
  paciente Paciente @relation(fields: [pacienteId], references: [id])
  pacienteId Int
}

model Exame{
  id    Int    @id @default(autoincrement())
  nome String?
  data DateTime @default(now())
  observacao String?
  imagem String?
  paciente Paciente @relation(fields: [pacienteId], references: [id])
  pacienteId Int
  medico Medico @relation(fields: [medicoId], references: [id])
  medicoId Int
  prontuario Prontuario? @relation(fields: [prontuarioId], references: [id])
  prontuarioId Int?
  anexoImagem String?
}

model Prontuario{
  id    Int    @id @default(autoincrement())
  data DateTime
  observacao String
  medicamento String?
  dosagem String?
  dias String?
  observacaoReceita String?
  medico Medico? @relation(fields: [medicoId], references: [id])
  medicoId Int?
  receita Receita? @relation(fields: [receitaId], references: [id])
  receitaId Int?
  paciente Paciente @relation(fields: [pacienteId], references: [id])
  pacienteId Int
  exames Exame[]
}

model Endereco{
  id    Int    @id @default(autoincrement())
  rua String? 
  cidade String? 
  bairro String?
  numero Int?
  paciente Paciente? @relation(fields: [pacienteId], references: [id])
  pacienteId Int? @unique
}
