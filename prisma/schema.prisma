// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Usuario{
  id    Int    @id @default(autoincrement())
  email String 
  senha String
  nome String
  idade Int   
  sexo String 
  rg String  @unique
  cpf Int @unique
  telefone Int
  ativo Boolean
  role  Role
}

enum Role {
  RECEPCIONISTA
  ADMIN
}

model Medico{
  id    Int    @id @default(autoincrement())
  crm Int
  agendamento Agendamento[]
  receita Receita[]
  consulta Consulta[]
  exame Exame[]
}

model Paciente{
  id    Int    @id @default(autoincrement())
  localnasc String
  estadoCivil String
  tipoSanguineo String 
  peso Int
  altura Float
  alergia String
  medicamento String
  observacao String
  agendamento Agendamento[]
  convenio Convenio[]
  receita Receita[]
  consulta Consulta[]
  exame Exame[]
  prontuario Prontuario[]
}

model Agendamento{
  id    Int    @id @default(autoincrement())
  paciente Paciente @relation(fields: [pacienteId], references: [id])
  pacienteId Int
  medico Medico @relation(fields: [medicoId], references: [id])
  medicoId Int
  data DateTime 
}

model Consulta{
  id    Int    @id @default(autoincrement())
  data DateTime
  status String
  motivo String
  paciente Paciente @relation(fields: [pacienteId], references: [id])
  pacienteId Int
  medico Medico @relation(fields: [medicoId], references: [id])
  medicoId Int
}

model Receita{
  id    Int    @id @default(autoincrement())
  medico Medico @relation(fields: [medicoId], references: [id])
  medicoId Int
  paciente Paciente @relation(fields: [pacienteId], references: [id])
  pacienteId Int
  medicamento String
  dosagem String
  dias  String 
  observacao String
  prontuario Prontuario[]
}

model Notificacao{
  id    Int    @id @default(autoincrement())
  titulo String
  mensagem String
  lida String 
  data DateTime
}

model Convenio{
  id    Int    @id @default(autoincrement())
  nome String
  numCarteirinha String
  validade DateTime
  paciente Paciente @relation(fields: [pacienteId], references: [id])
  pacienteId Int
}

model Exame{
  id    Int    @id @default(autoincrement())
  data DateTime
  observacao String
  paciente Paciente @relation(fields: [pacienteId], references: [id])
  pacienteId Int
  medico Medico @relation(fields: [medicoId], references: [id])
  medicoId Int
}

model Prontuario{
  id    Int    @id @default(autoincrement())
  receita Receita @relation(fields: [receitaId], references: [id])
  receitaId Int
  paciente Paciente @relation(fields: [pacienteId], references: [id])
  pacienteId Int
}

model Endereco{
  id    Int    @id @default(autoincrement())
  rua String 
  cidade String 
  bairro String
  numero Int
}